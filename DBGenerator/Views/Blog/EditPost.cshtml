@model DBGenerator.Models.Blog.EditPostViewModel
@using DBGenerator.Models.Blog

@await Html.PartialAsync("_EditPostNavBar", Model.Post)

<div class="post-container">
	<h3>Edytuj post</h3>
	<form asp-action="SavePostChanges" method="post">			
		<input type="hidden" asp-for="Post.Id" />
		<input type="hidden" asp-for="Post.NameUrl" />

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Title"></label>
			<input asp-for="Post.Title" class="form-control" />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Description"></label>
			<textarea asp-for="Post.Description" class="form-control" rows="3"></textarea>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Tags"></label>
			<input asp-for="Post.Tags" class="form-control" />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.PublishDate"></label>
			<input asp-for="Post.PublishDate" type="datetime-local" class="form-control" />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Position" class="form-label"></label>
			<select asp-for="Post.Position" class="form-select">
				@foreach (Position pos in Enum.GetValues(typeof(Position)))
				{
					if (@Model.Post.Position == pos)
					{
						<option value="@pos" selected>@pos</option>
					}
					else
					{
						<option value="@pos">@pos</option>
					}
				}
			</select>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Status" class="form-label"></label>
			<select asp-for="Post.Status" class="form-select">
				<option value="">-- wybierz --</option>
				@foreach (Status st in Enum.GetValues(typeof(Status)))
				{
					if (@Model.Post.Status == st)
					{
						<option value="@st" selected>@st</option>
					}
					else
					{
						<option value="@st">@st</option>
					}
				}
			</select>		
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.CategoryId" class="form-label"></label>
			<select asp-for="Post.CategoryId" class="form-select">
				@foreach (var cat in Model.Categories)
				{
					if (Model.Post.CategoryId == cat.Id)
					{
						<option value="@cat.Id" selected>@cat.Name</option>
					}
					else
					{
						<option value="@cat.Id">@cat.Name</option>
					}
				}
			</select>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.ImageUrl"></label>
			<input asp-for="Post.ImageUrl" class="form-control" />
		</div>


		<div style="margin-bottom:10px;">
			<img src="@Model.Post.ImageUrl" style="width:50%; border-radius:5px;" />
		</div>

		<div style="text-align:right;">
			<button type="submit"
					class="btn btn-light btn-sm shadow-sm text-dark fw-bold"
					style="min-width:80px;">
				Zapisz
			</button>
		</div>
	</form>
</div>



<div class="post-container--short">
	<h3>Elementy posta</h3>

	<form asp-action="SaveElementsChanges" method="post">
		<input type="hidden" asp-for="Post.Id" />
		<input type="hidden" asp-for="Post.Title"/>
		<input type="hidden" asp-for="Post.NameUrl"/>
		<input type="hidden" asp-for="Post.Description"/>
		<input type="hidden" asp-for="Post.Tags"/>
		<input type="hidden" asp-for="Post.PublishDate"/>
		<input type="hidden" asp-for="Post.Position"/>
		<input type="hidden" asp-for="Post.Status"/>
		<input type="hidden" asp-for="Post.ImageUrl"/>
		<input type="hidden" asp-for="Post.Category"/>
		<input type="hidden" asp-for="Post.Metas"/>
		@for (int i = 0; i < Model.PostElements.Count; i++)
		{			
			<div style="background-color:#007bff; padding:10px; margin-bottom:10px; border-radius:5px;">
				<input type="hidden" asp-for="PostElements[i].PostElement.Id" />
				<input type="hidden" asp-for="PostElements[i].PostElement.Post.Id" />

				<label>Type:</label>
				<select asp-for="PostElements[@i].PostElement.Type" class="form-select" style="margin-bottom:5px;">
					@foreach (ElementType tp in Enum.GetValues(typeof(ElementType)))
					{
						if (Model.PostElements[i].PostElement.Type == tp)
						{
							<option value="@tp" selected>@tp</option>
						}
						else
						{
							<option value="@tp">@tp</option>
						}
					}
				</select>

				<label>Content1:</label>
				<input type="text" asp-for="PostElements[i].PostElement.Content1" class="form-control" style="margin-bottom:5px;" />
				
				@if (Model.PostElements[i].Content2Visibility)
				{
					<label>Content2:</label>
					<input type="text" asp-for="PostElements[i].PostElement.Content2" class="form-control" style="margin-bottom:5px;" />
				}

				@if (Model.PostElements[i].Content3Visibility)
				{
					<label>Content3:</label>
					<input type="text" asp-for="PostElements[i].PostElement.Content3" class="form-control" style="margin-bottom:5px;" />
				}

				@if (Model.PostElements[i].Content4Visibility)
				{
					<label>Content4:</label>
					<input type="text" asp-for="PostElements[i].PostElement.Content4" class="form-control" style="margin-bottom:5px;" />
				}

				<label>Order:</label>
				<input type="number" asp-for="PostElements[i].PostElement.Order" class="form-control" style="margin-bottom:5px;" />
			</div>
		}
		<div class="ms-3 d-flex align-items-center justify-content-end">
			<button type="submit" name="actionType" value="save"
					class="btn btn-light btn-sm shadow-sm text-dark fw-bold me-2"
					style="min-width:80px;">
				Zapisz
			</button>
			<button type="submit" name="actionType" value="add"
					class="btn btn-light btn-sm shadow-sm text-dark fw-bold"
					style="min-width:80px;">
				Dodaj element
			</button>
		</div>
	</form>
</div>

@if (TempData["SuccessMessage"] != null)
{
	<div id="successToast" class="success-toast">
		@TempData["SuccessMessage"]
	</div>
}
<script src="~/js/postScripts.js" asp-append-version="true"></script>

