@using DBGenerator.Models.Blog
@model PostCategoryViewModel

<div class="post-container">
	<h3>Dodaj post</h3>
	<form asp-action="SaveNewPost" method="post">

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Title"></label>
			<input asp-for="Post.Title" class="form-control" required />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Description"></label>
			<textarea asp-for="Post.Description" class="form-control" required rows="3"></textarea>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.NameUrl">NameUrl</label>
			<input asp-for="Post.NameUrl" class="form-control" required />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Tags">Tags</label>
			<input asp-for="Post.Tags" class="form-control" required />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.PublishDate">Publish Date</label>
			<input asp-for="Post.PublishDate" class="form-control" required />
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Position"></label>
			<select asp-for="Post.Position" class="form-select" required>
				@foreach (Position pos in Enum.GetValues(typeof(Position)))
				{
					<option value="@pos">@pos</option>
				}
			</select>
		</div>
		
		<div style="margin-bottom:15px;">
			<label asp-for="Post.Status"></label>
			<select asp-for="Post.Status" class="form-select" required>
				@foreach (Status st in Enum.GetValues(typeof(Status)))
				{
					<option value="@st">@st </option>
				}
			</select>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.Category"></label>
			<select asp-for="Post.CategoryId" class="form-select" required>
				@foreach (var cat in Model.Categories)
				{
					<option value="@cat.Id">@cat.Name</option>
				}
			</select>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Post.ImageUrl"></label>
			<input asp-for="Post.ImageUrl" class="form-control" required />
		</div>

		<div style="text-align:right;">
			<button type="submit"
					class="btn btn-light btn-sm shadow-sm text-dark fw-bold"
					style="min-width:80px;">
				Zapisz
			</button>
		</div>
	</form>
</div>