@using DBGenerator.Models.Blog
@model List<Post>


@{
    var updatedId = TempData["UpdatedPostId"] as int?;
}


<div class="container mt-4">

    @foreach (var post in Model)
    {
        var isUpdated = updatedId.HasValue && updatedId.Value == post.Id;
        var borderStyle = isUpdated
        ? "2px solid lime; box-shadow:0 0 15px lime;"
        : "1px solid rgba(255,255,255,0.3); box-shadow:0 0 10px rgba(255,255,255,0.4);";
        var updatedIdAttr = isUpdated ? "updated-post" : "";

        <div id="@updatedIdAttr" class="card text-white mb-3" style="
                    max-width:900px;
                    margin:20px auto;
                    background-color:rgba(0,0,0,0.1);
                    color:white;
                    padding:20px;
                    border-radius:12px;
                    border:@borderStyle;
                    backdrop-filter: blur(6px);
                ">
            <div class="d-flex align-items-center">

                <img src="@post.ImageUrl"
                     class="img-fluid rounded"
                     style="width:150px; margin-right:15px;" />

                <div class="flex-grow-1">
                    <h5>@post.Title</h5>
                    <p class="mb-1" style="font-size:0.9rem;">@post.Description</p>
                    <small>ID: @post.Id</small><br />
                    <small>Opublikowano: @post.PublishDate.ToString("dd.MM.yyyy HH:mm")</small>
                </div>

                <div class="ms-3 d-flex align-items-center">
                    <a class="btn btn-sm fw-bold"
                       asp-action="EditPost"
                       asp-route-id="@post.Id"
                       style="
                     min-width:80px;
                     background-color: transparent;
                     border: 1px solid white;
                     color: white;
                     box-shadow: 0 0 4px rgba(255,255,255,0.7);
                     transition: 0.3s;
           "
                       onmouseover="this.style.boxShadow='0 0 15px rgba(255,255,255,1)'"
                       onmouseout="this.style.boxShadow='0 0 8px rgba(255,255,255,0.7)'">
                        Edytuj
                    </a>
                </div>
                <div class="ms-3 d-flex align-items-center">
                    <a class="btn btn-sm fw-bold"
                       asp-action="CopyPost"
                       asp-route-id="@post.Id"
                       style="
                         min-width:80px;
                         background-color: transparent;
                         border: 1px solid white;
                         color: white;
                         box-shadow: 0 0 4px rgba(255,255,255,0.7);
                         transition: 0.3s;
               "
                       onmouseover="this.style.boxShadow='0 0 15px rgba(255,255,255,1)'"
                       onmouseout="this.style.boxShadow='0 0 8px rgba(255,255,255,0.7)'">
                        Klonuj
                    </a>
                </div>
                <div class="ms-3 d-flex align-items-center">
                    <a class="btn btn-sm fw-bold"
                       asp-action="DeletePost"
                       asp-route-id="@post.Id"
                       style="
                             min-width:50px;
                             background-color: transparent;
                             border: 1px solid white;
                             color: white;
                             box-shadow: 0 0 4px rgba(255,255,255,0.7);
                             transition: 0.3s;
                   "
                       onmouseover="this.style.boxShadow='0 0 15px rgba(255,255,255,1)'"
                       onmouseout="this.style.boxShadow='0 0 8px rgba(255,255,255,0.7)'">
                        X
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<script>

    setTimeout(() => {
        const el = document.getElementById("updated-post");
        if (el) {
            el.style.border = "1px solid rgba(255,255,255,0.3)";
            el.style.boxShadow = "0 0 10px rgba(255,255,255,0.4)";
        }
    }, 6000);

    document.addEventListener("click", () => {
        const el = document.getElementById("updated-post");
        if (el) {
            el.style.border = "1px solid rgba(255,255,255,0.3)";
            el.style.boxShadow = "0 0 10px rgba(255,255,255,0.4)";
        }
    });
</script>
