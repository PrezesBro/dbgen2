@using DBGenerator.Models.Blog
@model PostPageViewModel


@{
    var updatedId = TempData["UpdatedPostId"] as int?;
}

<div class="d-flex align-items-center">
    <div class="ms-auto">
        <a class="btn white fw-bold px-3 py-2 fs-6 me-2"
           asp-action="AddNewCategory">
            Dodaj Kategorie
        </a>
        <a class="btn gold fw-bold px-3 py-2 fs-6"
           asp-action="AddNewPost">
             Dodaj Post
        </a>
    </div>
</div>


<div class="container mt-4">

    @foreach (var post in Model.Posts)
    {
        var isUpdated = updatedId.HasValue && updatedId.Value == post.Id;
        
        var updatedIdAttr = isUpdated ? "updated-post" : "";

        <div id="@updatedIdAttr" class="card text-white mb-3 post-box @(isUpdated ? "post-box-update" : "")">
            <div class="d-flex align-items-center">

                <img src="@post.ImageUrl"
                     class="img-fluid rounded"
                     style="width:150px; margin-right:15px;" />

                <div class="flex-grow-1">
                    <h5>@post.Title</h5>
                    <p class="mb-1" style="font-size:0.9rem;">@post.Description</p>
                    <small>ID: @post.Id</small><br />
                    <small>Opublikowano: @post.PublishDate.ToString("dd.MM.yyyy HH:mm")</small>
                </div>

                <div class="ms-3 d-flex align-items-center">
                    <a class="btn white btn-sm fw-bold"
                       asp-action="EditPost"
                       asp-route-id="@post.Id">                    
                        Edytuj
                    </a>
                </div>
                <div class="ms-3 d-flex align-items-center">
                    <a class="btn white btn-sm fw-bold"
                       asp-action="CopyPost"
                       asp-route-id="@post.Id">
                        Klonuj
                    </a>
                </div>
                <div class="ms-3 d-flex align-items-center">
                    <a class="btn white btn-sm fw-bold"
                       asp-action="DeletePost"
                       asp-route-id="@post.Id">
                        X
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-12 align-content-center">
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item"><a class="page-link" asp-action="GetAllPosts" asp-controller="Blog">Najnowsze</a></li>
                @foreach (var p in Model.PageList)
                {
                    @if (p == 0)
                    {
                        <li class="page-item"><p class="page-link">...</p></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" asp-action="GetAllPosts" asp-controller="Blog" asp-route-p="@p">@p</a></li>
                    }
                }
                <li class="page-item"><a class="page-link" asp-action="GetAllPosts" asp-controller="Blog" asp-route-p="@Model.TotalPages">Najstarsze</a></li>
            </ul>
        </nav>
    </div>
</div>

<script src="~/js/blogScripts.js" asp-append-version="true"></script>